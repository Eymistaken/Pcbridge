        {
          "op": "key",
          "args": [
            "ctrl+shift+t"
          ]
        }
      ],
      "expect": {
        "events": [
          [
            "EV_KEY",
            "KEY_LEFTCTRL",
            1
          ],
          [
            "EV_KEY",
            "KEY_LEFTSHIFT",
            1
          ],
