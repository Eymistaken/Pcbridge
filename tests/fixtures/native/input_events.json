{
  "schema_version": 1,
  "about": "Golden uinput events of the Python input backend. The Rust keyboard and pointer (PLAN.md Tasks 5.2, 5.3) must write the same events for the same calls. Recorded once from the Python backend on 2026-09-13 and reviewed; tests replay it and never regenerate it.",
  "canvas": [
    3840,
    1080
  ],
  "backend": {
    "pointer_speed": 5000,
    "pointer_max_ms": 500,
    "move_step_seconds": 0.008,
    "move_min_ms": 60,
    "drag_min_steps": 10,
    "hold_max_seconds": 120
  },
  "event_format": "[type, code, value] as evdev names; [\"SYN\"] is SYN_REPORT; [\"sleep\", seconds] is a pause the backend takes",
  "devices": {
