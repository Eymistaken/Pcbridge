#!/usr/bin/env python3
"""Sahte `claude` — e2e testinin ajan ayristirma kontrolleri icin.

NEDEN VAR
    `parse_claude_stream_json` sabit bir girdiyle olculmek zorunda: gercek
    `claude` her cagrida baska metin, baska oturum kimligi ve baska maliyet
    uretir. Bu betik sabit bir stream-json akisi basar; boylece dogrulanan sey
    ajanin zekasi degil BIZIM AYRISTIRICIMIZ olur.

KULLANIM
    Dogrudan cagirma; `tests/test_models.py` (11. bolum) bunu calistirip
    ciktisini ayristiriciya veriyor. Sunucu gerekmiyor:

        ./.venv/bin/python tests/test_models.py

SUNUCUYA PATH ILE ENJEKTE EDILEMEZ -- olculdu
    `jobs.py` her isi `bash -lc` ile baslatiyor. `-l` login kabugu demek, yani
    `~/.profile` yeniden kosuyor ve `$HOME/.local/bin`'i PATH'in BASINA
    ekliyor. Sunucuyu `PATH=tests/fake_agents:$PATH` ile baslatsan bile ajan
    yine gercek `claude`'a cozuluyor. `test_e2e.py`'nin 12. bolumundeki
    ayristirma kontrolleri bu yuzden atlanir; kapsami buraya tasindi.
"""

from __future__ import annotations

import json
import sys

SESSION_ID = "sess-abc-123"


def main() -> int:
    argv = sys.argv[1:]
    prompt = ""
    model = "claude-sonnet-5"
    resumed = None

    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == "-p" and i + 1 < len(argv):
            prompt = argv[i + 1]
            i += 2
            continue
        if arg == "--model" and i + 1 < len(argv):
            model = argv[i + 1]
            i += 2
            continue
        if arg == "--resume" and i + 1 < len(argv):
            resumed = argv[i + 1]
            i += 2
            continue
        i += 1

    def emit(obj: dict) -> None:
        print(json.dumps(obj, ensure_ascii=False), flush=True)

    emit(
        {
            "type": "system",
            "subtype": "init",
            "session_id": resumed or SESSION_ID,
            "model": model,
            "cwd": "/tmp/pcb/work",
        }
    )
    emit(
        {
            "type": "assistant",
            "message": {"content": [{"type": "text", "text": "Once dizine bakiyorum."}]},
        }
    )
    emit(
        {
            "type": "assistant",
            "message": {
                "content": [
                    {"type": "tool_use", "name": "Bash", "input": {"command": "ls -la"}}
                ]
            },
        }
    )
    emit(
        {
            "type": "user",
            "message": {"content": [{"type": "tool_result", "content": "toplam 0"}]},
        }
    )
    emit(
        {
            "type": "result",
            "subtype": "success",
            "session_id": resumed or SESSION_ID,
            "result": f"Istek tamamlandi: {prompt}",
            "total_cost_usd": 0.0123,
            "duration_ms": 2345,
            "num_turns": 3,
            "is_error": False,
            "modelUsage": {model: {"inputTokens": 100, "outputTokens": 20}},
        }
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
