#!/bin/sh
# pcbridge screenshot shell -- a local visual agent calls this from Bash.
# The logic lives in `pcbridge/cli/shot.py`; this only finds the venv
# (the venv has Pillow and evdev, the system python does not).
set -eu
SELF=$(readlink -f "$0")
ROOT=$(dirname "$(dirname "$SELF")")
exec "$ROOT/.venv/bin/python" -m pcbridge.cli.shot "$@"
