[Unit]
Description=pcbridge MCP server
Documentation=https://github.com/Eymistaken/Pcbridge
After=network-online.target
# Desktop control and notifications need the graphical session's environment
# (WAYLAND_DISPLAY, DBUS_SESSION_BUS_ADDRESS). GNOME imports it into the user
# manager at login; pcbridge also repairs a missing or broken value itself.
# Deliberately NOT added:
#   PartOf=graphical-session.target  -> logging out would kill pcbridge, and
#     the agent, tmux and shell tools do not need the desktop at all.
After=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h
ExecStart=__DIR__/.venv/bin/python -m pcbridge.server
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
# No PATH, DISPLAY or model variables here:
#   PATH     comes from the user manager; agent CLIs installed per user
#            (~/.local/bin, ~/.npm-global/bin, nvm, bun) are found anyway.
#   DISPLAY  is derived from the running Xwayland when it is missing.
#   ANTHROPIC_MODEL / CLAUDE_CODE_EFFORT_LEVEL must never be set: jobs inherit
#            this environment and that variable silently overrides --effort.
StandardOutput=journal
StandardError=journal
# When the service stops, close the desktop grant and stop every screencast
# helper. The grant lives on disk (state_dir/desktop_unlock.json) and
# `pcb-do` reads it from there, so a grant left open would still authorize
# it. The leading `-` keeps a failure here from blocking the stop.
ExecStopPost=-__DIR__/.venv/bin/python -m pcbridge.cli.lock

[Install]
WantedBy=default.target
