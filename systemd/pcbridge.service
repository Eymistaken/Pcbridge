[Unit]
Description=pcbridge MCP server
Documentation=https://github.com/Eymistaken/Pcbridge
# The socket is what local clients connect to. It is always listening, so a
# client that arrives while the daemon is down or restarting starts it.
Requires=pcbridge.socket
After=pcbridge.socket network-online.target graphical-session.target
# Desktop control needs the graphical session's environment (WAYLAND_DISPLAY,
# DBUS_SESSION_BUS_ADDRESS). GNOME imports it into the user manager at login,
# and pcbridge repairs a missing or broken value itself. Deliberately NOT
# added: PartOf=graphical-session.target, which would stop pcbridge at
# logout although the agent, tmux and shell tools do not need the desktop.

[Service]
Type=simple
WorkingDirectory=%h
# -P: the working directory (the home directory here) is not put on the
# module path, so a checkout named ~/pcbridge cannot shadow the package.
ExecStart=__PYTHON__ -P -m pcbridge serve
# A crash restarts quickly; exit code 75 is the daemon restarting itself to
# load a newer installed version (only while no job, grant or call is active).
Restart=on-failure
RestartSec=1
RestartForceExitStatus=75
# 78 is a configuration error: it stays until the file is fixed, so do not
# retry every second. The reason is in `journalctl --user -u pcbridge`.
RestartPreventExitStatus=78
# SIGTERM shuts down cleanly (held input released, status.json says stopped);
# if that hangs, systemd kills it after this long.
TimeoutStopSec=15
Environment=PYTHONUNBUFFERED=1
# No PATH, DISPLAY or model variables here:
#   PATH     comes from the user manager; agent CLIs installed per user
#            (~/.local/bin, ~/.npm-global/bin, nvm, bun) are found anyway.
#   DISPLAY  is derived from the running Xwayland when it is missing.
#   ANTHROPIC_MODEL / CLAUDE_CODE_EFFORT_LEVEL must never be set: jobs inherit
#            this environment and that variable silently overrides --effort.
StandardOutput=journal
StandardError=journal
# Jobs run in their own pcbridge-job-*.scope units and survive a restart of
# this service; `pcbridge stop` ends them. When the service stops, close the
# desktop grant and stop every screencast helper: the grant lives on disk and
# `pcb-do` reads it from there. The leading `-` keeps a failure here from
# blocking the stop.
ExecStopPost=-__PYTHON__ -P -m pcbridge.cli.lock

[Install]
WantedBy=default.target
Also=pcbridge.socket
